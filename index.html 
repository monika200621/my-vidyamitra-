<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>VidyaMitra: study friend</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;600;800&family=Bitter:wght@700;800&display=swap" rel="stylesheet">
<style>
:root {
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  --bg: #f2f6f4; --side: #e3ede8; --card: #ffffff; --ink: #14304a; --muted: #5b7083; --line: #cfdcd6;
  --accent: #f2a900; --accent-ink: #3a2a00; --me: #14304a; --me-ink: #ffffff;
  --good: #1e7b4f; --good-bg: #dcf2e6; --bad: #b3372b; --bad-bg: #fbe3df;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0f1c28; --side: #14293a; --card: #172a3b; --ink: #e6eef5; --muted: #93a8ba; --line: #2b4357;
    --accent: #f2b53a; --accent-ink: #261b00; --me: #f2b53a; --me-ink: #261b00;
    --good: #5fd39b; --good-bg: #123a2a; --bad: #ff8f82; --bad-bg: #44211d;
  }
}
:root[data-theme="dark"] {
  --bg: #0f1c28; --side: #14293a; --card: #172a3b; --ink: #e6eef5; --muted: #93a8ba; --line: #2b4357;
  --accent: #f2b53a; --accent-ink: #261b00; --me: #f2b53a; --me-ink: #261b00;
  --good: #5fd39b; --good-bg: #123a2a; --bad: #ff8f82; --bad-bg: #44211d;
}
html { scroll-padding-top: env(safe-area-inset-top, 0px); }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: "Mukta", system-ui, -apple-system, "Segoe UI", "Noto Sans Devanagari", "Noto Sans Kannada", "Noto Sans Tamil", "Noto Sans Telugu", sans-serif; font-size: 18px; line-height: 1.5; }
.layout { display: grid; grid-template-columns: 270px 1fr; min-height: 100vh; }
aside { background: var(--side); border-right: 2px solid var(--line); padding: 20px 16px; }
main { padding: 22px 28px 48px; max-width: 860px; width: 100%; }
.brand { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
.spine { width: 12px; height: 40px; background: var(--accent); border-radius: 4px; flex: none; }
.brand h2 { font-family: "Bitter", Georgia, serif; font-size: 1.5rem; margin: 0; }
.cap { color: var(--muted); font-size: .92rem; margin: 0 0 16px; }
aside label { display: block; font-weight: 600; font-size: .92rem; margin: 12px 0 4px; }
input[type=text], select { width: 100%; font: inherit; font-size: 1rem; padding: 9px 10px; border: 2px solid var(--ink); border-radius: 8px; background: var(--card); color: var(--ink); }
h1 { font-family: "Bitter", Georgia, serif; font-size: 2.3rem; margin: 0 0 12px; line-height: 1.15; }
.tabs { display: flex; gap: 4px; border-bottom: 2px solid var(--line); margin-bottom: 16px; flex-wrap: wrap; }
.tab { font: inherit; font-weight: 600; cursor: pointer; background: none; border: none; border-bottom: 4px solid transparent; padding: 8px 14px; color: var(--muted); margin-bottom: -2px; }
.tab[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--accent); }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.pane[hidden] { display: none; }
#chat { height: 46vh; min-height: 260px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding: 4px 0 10px; }
.msg { max-width: 90%; padding: 10px 14px; border-radius: 12px; border: 2px solid var(--ink); background: var(--card); word-wrap: break-word; }
.msg.me { align-self: flex-end; background: var(--me); color: var(--me-ink); border-color: var(--me); }
.msg.err { border-color: var(--bad); color: var(--bad); }
.chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 4px 0 10px; }
.chip { font: inherit; font-size: .95rem; cursor: pointer; background: var(--card); color: var(--ink); border: 2px solid var(--line); border-radius: 20px; padding: 6px 14px; }
.chip:hover:not(:disabled) { border-color: var(--ink); }
.chip:disabled { opacity: .5; cursor: default; }
form.bar { display: flex; gap: 8px; }
textarea { flex: 1; font: inherit; font-size: 1.05rem; resize: none; padding: 10px 12px; height: 52px; border: 2px solid var(--ink); border-radius: 10px; background: var(--card); color: var(--ink); }
.btn { font: inherit; font-weight: 800; cursor: pointer; background: var(--accent); color: var(--accent-ink); border: 2px solid var(--ink); border-radius: 10px; padding: 10px 20px; }
.btn.ghost { background: transparent; color: var(--ink); font-weight: 600; }
.btn:disabled { opacity: .5; cursor: default; }
.note { color: var(--muted); font-size: .9rem; margin-top: 12px; }
.card { background: var(--card); border: 2px solid var(--ink); border-radius: 10px; padding: 18px; }
.qtext { font-size: 1.3rem; font-weight: 600; margin: 4px 0 14px; }
.opts { display: grid; gap: 10px; }
.opt { text-align: left; font: inherit; cursor: pointer; background: var(--bg); color: var(--ink); border: 2px solid var(--line); border-radius: 8px; padding: 12px 14px; width: 100%; }
.opt:hover:not(:disabled) { border-color: var(--ink); }
.opt:disabled { cursor: default; }
.opt.right { background: var(--good-bg); border-color: var(--good); }
.opt.wrong { background: var(--bad-bg); border-color: var(--bad); }
.fb { margin-top: 14px; padding: 12px 14px; border-radius: 8px; }
.fb.ok { background: var(--good-bg); } .fb.no { background: var(--bad-bg); }
.meter { height: 10px; background: var(--line); border-radius: 6px; overflow: hidden; margin: 6px 0 14px; }
.meter i { display: block; height: 100%; background: var(--ink); }
.meter i.low { background: var(--bad); } .meter i.mid { background: var(--accent); } .meter i.hi { background: var(--good); }
.top { display: flex; justify-content: space-between; color: var(--muted); font-size: .95rem; gap: 8px; flex-wrap: wrap; }
.score { font-family: "Bitter", serif; font-size: 3rem; font-weight: 800; line-height: 1; }
.trow { display: flex; justify-content: space-between; font-weight: 600; margin-top: 10px; }
.tip { background: var(--bg); border-left: 6px solid var(--accent); padding: 12px 14px; border-radius: 4px; margin: 14px 0; }
.actions { display: flex; gap: 10px; flex-wrap: wrap; }
.metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
.metric b { display: block; font-family: "Bitter", serif; font-size: 2rem; }
.dots::after { content: "..."; animation: blink 1s steps(3, end) infinite; }
@keyframes blink { 0% { opacity: .2 } 50% { opacity: 1 } 100% { opacity: .2 } }
@media (prefers-reduced-motion: reduce) { .dots::after { animation: none; } }
@media (max-width: 760px) {
  .layout { grid-template-columns: 1fr; }
  aside { border-right: none; border-bottom: 2px solid var(--line); }
  main { padding: 16px 14px 40px; }
  h1 { font-size: 1.8rem; }
}
</style>
</head>
<body>
<div class="layout">
  <aside>
    <div class="brand"><div class="spine"></div><h2>VidyaMitra</h2></div>
    <p class="cap">Your study friend | SDG 4: Quality Education</p>
    <label for="name">Your name</label>
    <input type="text" id="name" placeholder="Student" autocomplete="off">
    <label for="cls">Class</label>
    <select id="cls"><option>6</option><option>7</option><option selected>8</option><option>9</option><option>10</option></select>
    <label for="sub">Subject</label>
    <select id="sub"><option>Maths</option><option selected>Science</option><option>English</option></select>
  </aside>

  <main>
    <h1 id="hello">Hello Student! 👋</h1>
    <div class="tabs" role="tablist">
      <button class="tab" role="tab" id="t-tutor" aria-selected="true" aria-controls="p-tutor">Ask the Tutor</button>
      <button class="tab" role="tab" id="t-quiz" aria-selected="false" aria-controls="p-quiz">Adaptive Quiz</button>
      <button class="tab" role="tab" id="t-prog" aria-selected="false" aria-controls="p-prog">My Progress</button>
    </div>

    <section class="pane" id="p-tutor" role="tabpanel" aria-labelledby="t-tutor">
